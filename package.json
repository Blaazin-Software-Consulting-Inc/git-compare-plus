      {
        "command": "gitComparePlus.openFile",
        "title": "Open File",
        "category": "Git Compare+",
        "icon": "$(go-to-file)"
      },
      {
        "command": "gitComparePlus.openFileAtBase",
        "title": "Open File at Base",
        "category": "Git Compare+"
      },
      {
        "command": "gitComparePlus.openCommit",
        "title": "Open Commit",
        "category": "Git Compare+"
      },
      {
        "command": "gitComparePlus.compareWithCommit",
        "title": "Compare With This Commit (show only what came after)",
        "category": "Git Compare+"
      },
      {
        "command": "gitComparePlus.rerun",
        "title": "Refresh Comparison",
        "category": "Git Compare+",
        "icon": "$(refresh)"
      },
      {
        "command": "gitComparePlus.changeBase",
        "title": "Change What It Is Compared Against…",
        "category": "Git Compare+",
        "icon": "$(git-compare)"
      },
      {
        "command": "gitComparePlus.toggleUncommitted",
