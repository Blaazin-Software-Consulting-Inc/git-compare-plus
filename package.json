          "group": "inline@2"
        },
        {
          "command": "gitComparePlus.compare",
          "when": "view == gitComparePlus.repositories && viewItem =~ /^comparable/",
          "group": "1_compare@1"
        },
        {
          "command": "gitComparePlus.compareWith",
          "when": "view == gitComparePlus.repositories && viewItem =~ /^comparable/",
          "group": "1_compare@2"
        },
        {
          "command": "gitComparePlus.setBase",
          "when": "view == gitComparePlus.repositories && viewItem =~ /^comparable\\.(worktree|branch)/ && viewItem =~ /^(?!.*\\.base$)/",
