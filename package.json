        "title": "Clear Comparison",
        "category": "Git Compare+",
        "icon": "$(clear-all)"
      },
      {
        "command": "gitComparePlus.fetch",
        "title": "Fetch",
        "category": "Git Compare+",
        "icon": "$(cloud-download)"
      },
      {
        "command": "gitComparePlus.fetchAll",
        "title": "Fetch All Repos",
        "category": "Git Compare+",
        "icon": "$(cloud-download)"
      },
      {
        "command": "gitComparePlus.fetchAndRerun",
        "title": "Fetch and Refresh Comparison",
        "category": "Git Compare+",
        "icon": "$(cloud-download)"
      },
      {
        "command": "gitComparePlus.createWorktree",
        "title": "Create Worktree…",
        "category": "Git Compare+",
        "icon": "$(new-folder)"
      },
      {
        "command": "gitComparePlus.removeWorktree",
        "title": "Remove Worktree(s)…",
        "category": "Git Compare+",
        "icon": "$(trash)"
      },
      {
        "command": "gitComparePlus.createBranch",
