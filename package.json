      },
      {
        "command": "branchCompare.openFileAtBase",
        "title": "Open File at Base",
        "category": "Branch & Worktree Compare"
      },
      {
        "command": "branchCompare.openCommit",
        "title": "Open Commit",
        "category": "Branch & Worktree Compare"
      },
      {
        "command": "branchCompare.compareWithCommit",
        "title": "Compare With This Commit (show only what came after)",
        "category": "Branch & Worktree Compare"
      },
      {
        "command": "branchCompare.copyCommitId",
        "title": "Copy Commit ID",
        "category": "Branch & Worktree Compare"
      },
      {
        "command": "branchCompare.rerun",
        "title": "Refresh Comparison",
        "category": "Branch & Worktree Compare",
        "icon": "$(refresh)"
      },
      {
        "command": "branchCompare.changeBase",
        "title": "Change What It Is Compared Against…",
        "category": "Branch & Worktree Compare",
        "icon": "$(git-compare)"
      },
      {
        "command": "branchCompare.toggleUncommitted",
        "title": "Include / Exclude Uncommitted Edits",
        "category": "Branch & Worktree Compare",
        "icon": "$(edit)"
      },
      {
        "command": "branchCompare.toggleMode",
        "title": "Switch: Since Branch Point / All Differences",
        "category": "Branch & Worktree Compare",
        "icon": "$(git-merge)"
      },
      {
        "command": "branchCompare.clear",
        "title": "Clear Comparison",
        "category": "Branch & Worktree Compare",
        "icon": "$(clear-all)"
      },
      {
        "command": "branchCompare.fetch",
        "title": "Fetch",
        "category": "Branch & Worktree Compare",
        "icon": "$(cloud-download)"
      },
      {
        "command": "branchCompare.fetchAll",
        "title": "Fetch All Repos",
        "category": "Branch & Worktree Compare",
        "icon": "$(cloud-download)"
      },
      {
        "command": "branchCompare.fetchAndRerun",
        "title": "Fetch and Refresh Comparison",
        "category": "Branch & Worktree Compare",
        "icon": "$(cloud-download)"
      },
      {
        "command": "branchCompare.createWorktree",
        "title": "Create Worktree…",
        "category": "Branch & Worktree Compare",
        "icon": "$(new-folder)"
      },
      {
        "command": "branchCompare.removeWorktree",
        "title": "Remove Worktree(s)…",
        "category": "Branch & Worktree Compare",
        "icon": "$(trash)"
      },
      {
        "command": "branchCompare.createBranch",
        "title": "Create Branch From Here…",
        "category": "Branch & Worktree Compare",
        "icon": "$(git-branch-create)"
      },
      {
        "command": "branchCompare.deleteBranch",
        "title": "Delete Branch(es)…",
        "category": "Branch & Worktree Compare",
        "icon": "$(trash)"
      },
      {
        "command": "branchCompare.switchBranch",
        "title": "Switch Main Worktree to This Branch",
        "category": "Branch & Worktree Compare"
      },
      {
        "command": "branchCompare.deleteSelected",
        "title": "Delete Selected Branches / Remove Selected Worktrees…",
        "category": "Branch & Worktree Compare"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "branchCompare.compareTwo",
          "when": "view == branchCompare.repositories",
          "group": "navigation@0"
        },
        {
          "command": "branchCompare.compareAll",
          "when": "view == branchCompare.repositories",
          "group": "navigation@1"
        },
        {
          "command": "branchCompare.fetchAll",
          "when": "view == branchCompare.repositories",
          "group": "navigation@1"
        },
        {
          "command": "branchCompare.refresh",
          "when": "view == branchCompare.repositories",
          "group": "navigation@2"
        },
        {
          "command": "branchCompare.openAllChanges",
          "when": "view == branchCompare.changes && branchCompare.hasComparison",
          "group": "navigation@1"
        },
        {
          "command": "branchCompare.rerun",
          "when": "view == branchCompare.changes && branchCompare.hasComparison",
          "group": "navigation@2"
        },
        {
          "command": "branchCompare.clear",
          "when": "view == branchCompare.changes && branchCompare.hasComparison",
          "group": "navigation@3"
        },
        {
          "command": "branchCompare.viewAsTree",
          "when": "view == branchCompare.changes && branchCompare.hasComparison && branchCompare.changesLayout != tree",
          "group": "navigation@4"
        },
        {
          "command": "branchCompare.viewAsList",
          "when": "view == branchCompare.changes && branchCompare.hasComparison && branchCompare.changesLayout == tree",
          "group": "navigation@4"
        },
        {
          "command": "branchCompare.changeBase",
          "when": "view == branchCompare.changes && branchCompare.hasComparison",
          "group": "1_setup@1"
        },
        {
          "command": "branchCompare.swapSides",
          "when": "view == branchCompare.changes && branchCompare.hasComparison",
          "group": "1_setup@4"
        },
        {
          "command": "branchCompare.changeSubject",
          "when": "view == branchCompare.changes && branchCompare.hasComparison",
          "group": "1_setup@0"
        },
        {
          "command": "branchCompare.toggleUncommitted",
          "when": "view == branchCompare.changes && branchCompare.hasComparison",
          "group": "1_setup@2"
        },
        {
          "command": "branchCompare.toggleMode",
          "when": "view == branchCompare.changes && branchCompare.hasComparison",
          "group": "1_setup@3"
        },
        {
          "command": "branchCompare.fetchAndRerun",
          "when": "view == branchCompare.changes && branchCompare.hasComparison",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "branchCompare.changeSubject",
          "when": "view == branchCompare.changes && viewItem =~ /^header\\.subject$/",
          "group": "inline@1"
        },
        {
          "command": "branchCompare.swapSides",
          "when": "view == branchCompare.changes && viewItem =~ /^header\\.(subject|base)$/",
          "group": "inline@2"
        },
        {
          "command": "branchCompare.changeDefaultBase",
          "when": "view == branchCompare.repositories && viewItem =~ /^comparable\\.repo/",
          "group": "2_base@0"
        },
        {
          "command": "branchCompare.openBranch",
          "when": "view == branchCompare.repositories && viewItem =~ /^comparable\\.branch/",
          "group": "inline@2"
        },
        {
          "command": "branchCompare.openBranch",
          "when": "view == branchCompare.repositories && viewItem =~ /^comparable\\.branch/",
          "group": "0_open@1"
        },
        {
          "command": "branchCompare.openFile",
          "when": "view == branchCompare.changes && viewItem =~ /^changedFile\\.(?!deleted$)/",
          "group": "inline@1"
        },
        {
          "command": "branchCompare.openFile",
          "when": "view == branchCompare.changes && viewItem =~ /^changedFile\\.(?!deleted$)/",
          "group": "1_open@1"
        },
        {
          "command": "branchCompare.openFileAtBase",
          "when": "view == branchCompare.changes && viewItem =~ /^changedFile\\.(?!(added|untracked)$)/",
          "group": "1_open@2"
        },
        {
          "command": "branchCompare.openCommit",
          "when": "view == branchCompare.changes && viewItem =~ /^commit$/",
          "group": "1_commit@1"
        },
        {
          "command": "branchCompare.compareWithCommit",
          "when": "view == branchCompare.changes && viewItem =~ /^commit$/",
          "group": "1_commit@2"
        },
        {
          "command": "branchCompare.copyCommitId",
          "when": "view == branchCompare.changes && viewItem =~ /^commit$/",
          "group": "2_copy@1"
        },
        {
          "command": "branchCompare.compare",
          "when": "view == branchCompare.repositories && viewItem =~ /^comparable/",
          "group": "inline@1"
        },
        {
          "command": "branchCompare.openWorktree",
          "when": "view == branchCompare.repositories && viewItem =~ /^comparable\\.worktree(\\.base)?$/",
          "group": "inline@2"
        },
        {
          "command": "branchCompare.compare",
          "when": "view == branchCompare.repositories && viewItem =~ /^comparable/",
          "group": "1_compare@1"
        },
        {
          "command": "branchCompare.compareWith",
          "when": "view == branchCompare.repositories && viewItem =~ /^comparable/",
          "group": "1_compare@2"
        },
        {
          "command": "branchCompare.setBase",
          "when": "view == branchCompare.repositories && viewItem =~ /^comparable\\.(worktree|branch)/ && viewItem =~ /^(?!.*\\.base$)/",
          "group": "2_base@1"
        },
        {
          "command": "branchCompare.clearBase",
          "when": "view == branchCompare.repositories && viewItem =~ /\\.(base|hasBase)$/",
          "group": "2_base@2"
        },
        {
          "command": "branchCompare.openWorktree",
          "when": "view == branchCompare.repositories && viewItem =~ /^comparable\\.worktree(\\.base)?$/",
          "group": "3_open@1"
        },
        {
          "command": "branchCompare.fetch",
          "when": "view == branchCompare.repositories && viewItem =~ /^comparable\\.repo/",
          "group": "4_git@1"
        },
        {
          "command": "branchCompare.createBranch",
          "when": "view == branchCompare.repositories && viewItem =~ /^comparable/",
          "group": "4_git@2"
        },
        {
          "command": "branchCompare.createWorktree",
          "when": "view == branchCompare.repositories && viewItem =~ /^comparable\\.branch\\.(remote|local(?!\\.checkedOut))/",
          "group": "4_git@3"
        },
        {
          "command": "branchCompare.switchBranch",
          "when": "view == branchCompare.repositories && viewItem =~ /^comparable\\.branch\\.(remote|local(?!\\.checkedOut))/",
          "group": "4_git@4"
        },
        {
          "command": "branchCompare.removeWorktree",
          "when": "view == branchCompare.repositories && viewItem =~ /^comparable\\.worktree(\\.base)?$/",
          "group": "5_danger@1"
        },
        {
          "command": "branchCompare.deleteBranch",
          "when": "view == branchCompare.repositories && viewItem =~ /^comparable\\.branch\\.local(?!\\.checkedOut)/",
          "group": "5_danger@2"
        }
      ],
      "scm/title": [
        {
          "command": "branchCompare.compareAll",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "branchCompare.openBranch",
          "when": "false"
        },
        {
          "command": "branchCompare.changeSubject",
          "when": "branchCompare.hasComparison"
        },
        {
          "command": "branchCompare.changeDefaultBase",
          "when": "false"
        },
        {
          "command": "branchCompare.compare",
          "when": "false"
        },
        {
          "command": "branchCompare.compareWith",
          "when": "false"
        },
        {
          "command": "branchCompare.setBase",
          "when": "false"
        },
        {
          "command": "branchCompare.clearBase",
          "when": "false"
        },
        {
          "command": "branchCompare.openWorktree",
          "when": "false"
        },
        {
          "command": "branchCompare.openChange",
          "when": "false"
        },
        {
          "command": "branchCompare.swapSides",
          "when": "branchCompare.hasComparison"
        },
        {
          "command": "branchCompare.openFile",
          "when": "false"
        },
        {
          "command": "branchCompare.openFileAtBase",
          "when": "false"
        },
        {
          "command": "branchCompare.openCommit",
          "when": "false"
        },
        {
          "command": "branchCompare.compareWithCommit",
          "when": "false"
        },
        {
          "command": "branchCompare.copyCommitId",
          "when": "false"
        },
        {
          "command": "branchCompare.openAllChanges",
          "when": "branchCompare.hasComparison"
        },
        {
          "command": "branchCompare.rerun",
          "when": "branchCompare.hasComparison"
        },
        {
          "command": "branchCompare.clear",
          "when": "branchCompare.hasComparison"
        },
        {
          "command": "branchCompare.changeBase",
          "when": "branchCompare.hasComparison"
        },
        {
          "command": "branchCompare.toggleUncommitted",
          "when": "branchCompare.hasComparison"
        },
        {
          "command": "branchCompare.toggleMode",
          "when": "branchCompare.hasComparison"
        },
        {
          "command": "branchCompare.fetch",
          "when": "false"
        },
        {
          "command": "branchCompare.createWorktree",
          "when": "false"
        },
        {
          "command": "branchCompare.removeWorktree",
          "when": "false"
        },
        {
          "command": "branchCompare.createBranch",
          "when": "false"
        },
        {
          "command": "branchCompare.deleteBranch",
          "when": "false"
        },
        {
          "command": "branchCompare.switchBranch",
          "when": "false"
        },
        {
          "command": "branchCompare.fetchAndRerun",
          "when": "branchCompare.hasComparison"
        },
        {
          "command": "branchCompare.deleteSelected",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Git Branch & Worktree Compare",
      "properties": {
        "branchCompare.includeUntracked": {
          "type": "boolean",
          "default": true,
          "description": "Treat untracked (never-added) files as uncommitted edits: shown as new files when uncommitted edits are included, and counted when they are not."
        },
        "branchCompare.includeUncommitted": {
          "type": "boolean",
          "default": true,
          "description": "When comparing a worktree, include its uncommitted (staged, unstaged and, per `includeUntracked`, untracked) edits. Can be toggled per comparison from the Changes header."
        },
        "branchCompare.compareMode": {
          "type": "string",
          "enum": [
            "sinceBranchPoint",
            "allDifferences"
          ],
          "enumDescriptions": [
            "Like a pull request: compare with where the branch split off, so later commits on the base are not shown.",
            "Every difference between the two sides."
          ],
          "default": "sinceBranchPoint",
          "description": "Default comparison mode. Can be switched per comparison from the Changes header."
        },
        "branchCompare.staleFetchHours": {
          "type": "number",
          "default": 24,
          "minimum": 1,
          "description": "Flag a repo (and a comparison with one of its remote branches) as possibly out of date when it has not been fetched for this many hours."
        },
        "branchCompare.remote": {
          "type": "string",
          "default": "origin",
          "description": "Remote whose HEAD branch is each repo's default branch. Use `upstream` if `origin` is your fork."
        },
        "branchCompare.defaultBranches": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "markdownDescription": "Default branch for specific repos, overriding `#branchCompare.remote#`. Keys are a repo's folder name or the absolute path of its main worktree; values are branch names, e.g. `{ \"api\": \"upstream/develop\" }`."
        },
        "branchCompare.blame.currentLine": {
          "type": "boolean",
          "default": true,
          "description": "Show who last changed the line under the cursor, and when, at the end of that line. Hover it for the full message and actions."
        },
        "branchCompare.blame.statusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show the author and age of the line under the cursor in the status bar. Click it to open the commit."
        },
        "branchCompare.changesLayout": {
          "type": "string",
          "enum": [
            "list",
            "tree"
          ],
          "enumDescriptions": [
            "Changed files in one list, each with its folder shown next to it.",
            "Changed files grouped into folders (single-child folders are combined)."
          ],
          "default": "list",
          "description": "How the Changes view lays out changed files. Toggle from the view's title bar."
        },
        "branchCompare.autoRefresh": {
          "type": "boolean",
          "default": true,
          "description": "Re-run the comparison in Changes automatically (about 1.5 s after edits, saves, commits or branch changes in the compared worktrees and repos). The Repositories view always follows git changes. Fetching is never automatic."
        }
      }
    },
    "keybindings": [
      {
        "command": "branchCompare.deleteSelected",
        "key": "delete",
        "mac": "cmd+backspace",
        "when": "focusedView == branchCompare.repositories && !inputFocus"
      }
    ]
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "npm run typecheck && node scripts/build.mjs",
    "build:production": "npm run typecheck && node scripts/build.mjs --production",
    "generate:icons": "node scripts/generate-diff-bar-icons.mjs",
    "test": "vitest run",
    "test:host": "node test/host/runHost.mjs",
    "budget": "node scripts/check-budget.mjs",
    "package": "npm run build:production && vsce package --no-dependencies --allow-missing-repository --skip-license --out branch-compare.vsix"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "~1.90.0",
    "@vscode/test-electron": "2.4.1",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "0.28.2",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
