{
  "name": "git-compare-plus",
  "displayName": "Git Compare+",
  "description": "Compare worktrees, branches, tags and commits side by side, with blame, file and line history, commit search and stashes. Lightweight: no account, no telemetry. For VS Code and Cursor.",
  "version": "1.0.0",
  "publisher": "blaazinsoftware",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Blaazin-Software-Consulting-Inc/git-compare-plus.git"
  },
  "bugs": {
    "url": "https://github.com/Blaazin-Software-Consulting-Inc/git-compare-plus/issues"
  },
  "homepage": "https://github.com/Blaazin-Software-Consulting-Inc/git-compare-plus#readme",
  "galleryBanner": {
    "color": "#1f2328",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "SCM Providers",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "git",
    "worktree",
    "branch",
    "compare",
    "diff",
    "blame",
    "history",
    "stash",
    "code review",
    "multi-root"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionDependencies": [
    "vscode.git"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Git Compare+ runs git in the workspace's folders, and git can run programs named in a repository's own configuration (hooks, fsmonitor). Trust the folder to use it."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Git Compare+ needs the repository's files on disk to run git."
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gitComparePlus",
          "title": "Git Compare+",
          "icon": "media/activity-icon.svg"
        }
      ]
    },
    "views": {
      "gitComparePlus": [
        {
          "id": "gitComparePlus.repositories",
          "name": "Repositories"
        },
        {
          "id": "gitComparePlus.changes",
          "name": "Changes"
        },
        {
          "id": "gitComparePlus.commits",
          "name": "Commits"
        },
        {
          "id": "gitComparePlus.history",
          "name": "History",
          "when": "gitComparePlus.historyShown"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "gitComparePlus.changes",
        "contents": "Nothing compared yet.\n\n[Compare…](command:gitComparePlus.compareTwo)\n\nPicks what to review, then what to compare it against. Or, in Repositories, click $(git-compare) next to a worktree or branch to review it against its repo's default branch.\n\n[Compare All Repos With Default Branch](command:gitComparePlus.compareAll)"
      },
      {
        "view": "gitComparePlus.commits",
        "contents": "Select a worktree or branch in Repositories to see its commits.\n\nOr search commits by message, author, file, changed text or ID, on every branch and tag.\n\n[Search Commits…](command:gitComparePlus.commits.search)\n\nShow Commit Details on any commit (in Changes or History) opens it here."
      }
    ],
    "commands": [
      {
        "command": "gitComparePlus.refresh",
        "title": "Refresh",
        "category": "Git Compare+",
        "icon": "$(refresh)"
      },
      {
        "command": "gitComparePlus.compareAll",
        "title": "Compare All Repos With Default Branch",
        "category": "Git Compare+",
        "icon": "$(diff-multiple)"
      },
      {
        "command": "gitComparePlus.compare",
        "title": "Review Against Default",
        "category": "Git Compare+",
        "icon": "$(git-compare)"
      },
      {
        "command": "gitComparePlus.compareWith",
        "title": "Review Against…",
        "category": "Git Compare+"
      },
      {
        "command": "gitComparePlus.setBase",
        "title": "Use as Default Against",
        "category": "Git Compare+",
        "icon": "$(target)"
      },
      {
        "command": "gitComparePlus.clearBase",
        "title": "Reset Default Against (use the default branch)",
        "category": "Git Compare+",
        "icon": "$(close)"
      },
      {
        "command": "gitComparePlus.openWorktree",
        "title": "Open Worktree in New Window",
        "category": "Git Compare+",
        "icon": "$(empty-window)"
      },
      {
        "command": "gitComparePlus.openChange",
        "title": "Open Change",
        "category": "Git Compare+"
      },
      {
        "command": "gitComparePlus.openAllChanges",
        "title": "Open All Changes",
        "category": "Git Compare+",
        "icon": "$(diff-multiple)"
      },
      {
        "command": "gitComparePlus.openBranch",
        "title": "Open…",
        "category": "Git Compare+",
        "icon": "$(window)"
      },
      {
