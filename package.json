          "group": "1_commit@1"
        },
        {
          "command": "gitComparePlus.compareWithCommit",
          "when": "view == gitComparePlus.changes && viewItem =~ /^commit$/",
          "group": "1_commit@2"
        },
        {
          "command": "gitComparePlus.compare",
          "when": "view == gitComparePlus.repositories && viewItem =~ /^comparable/",
          "group": "inline@1"
        },
        {
          "command": "gitComparePlus.openWorktree",
