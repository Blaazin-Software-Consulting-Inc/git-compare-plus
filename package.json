    "configuration": {
      "title": "Git Compare+",
      "properties": {
        "gitComparePlus.includeUntracked": {
          "type": "boolean",
          "default": true,
          "description": "Treat untracked (never-added) files as uncommitted edits: shown as new files when uncommitted edits are included, and counted when they are not."
        },
        "gitComparePlus.includeUncommitted": {
          "type": "boolean",
          "default": true,
          "description": "When comparing a worktree, include its uncommitted (staged, unstaged and, per `includeUntracked`, untracked) edits. Can be toggled per comparison from the Changes header."
        },
        "gitComparePlus.compareMode": {
          "type": "string",
          "enum": [
            "sinceBranchPoint",
            "allDifferences"
          ],
          "enumDescriptions": [
            "Like a pull request: compare with where the branch split off, so later commits on the base are not shown.",
            "Every difference between the two sides."
          ],
          "default": "sinceBranchPoint",
          "description": "Default comparison mode. Can be switched per comparison from the Changes header."
        },
        "gitComparePlus.staleFetchHours": {
          "type": "number",
          "default": 24,
          "minimum": 1,
          "description": "Flag a repo (and a comparison with one of its remote branches) as possibly out of date when it has not been fetched for this many hours."
        },
        "gitComparePlus.remote": {
          "type": "string",
          "default": "origin",
          "description": "Remote whose HEAD branch is each repo's default branch. Use `upstream` if `origin` is your fork."
        },
        "gitComparePlus.defaultBranches": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "markdownDescription": "Default branch for specific repos, overriding `#gitComparePlus.remote#`. Keys are a repo's folder name or the absolute path of its main worktree; values are branch names, e.g. `{ \"api\": \"upstream/develop\" }`."
        },
        "gitComparePlus.blame.currentLine": {
          "type": "boolean",
          "default": true,
          "description": "Show who last changed the line under the cursor, and when, at the end of that line. Hover it for the full message and actions."
        },
        "gitComparePlus.blame.statusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show the author and age of the line under the cursor in the status bar. Click it to open the commit."
        },
        "gitComparePlus.changesLayout": {
          "type": "string",
          "enum": [
            "list",
            "tree"
          ],
          "enumDescriptions": [
            "Changed files in one list, each with its folder shown next to it.",
            "Changed files grouped into folders (single-child folders are combined)."
          ],
          "default": "list",
          "description": "How the Changes view lays out changed files. Toggle from the view's title bar."
        },
        "gitComparePlus.autoRefresh": {
          "type": "boolean",
          "default": true,
          "description": "Re-run the comparison in Changes automatically (about 1.5 s after edits, saves, commits or branch changes in the compared worktrees and repos). The Repositories view always follows git changes. Fetching is never automatic."
        }
      }
    },
    "keybindings": [
      {
        "command": "gitComparePlus.deleteSelected",
        "key": "delete",
        "mac": "cmd+backspace",
        "when": "focusedView == gitComparePlus.repositories && !inputFocus"
      }
    ]
