        },
        {
          "command": "gitComparePlus.openWorktree",
          "when": "view == gitComparePlus.repositories && viewItem =~ /^comparable\\.worktree(\\.base)?$/",
          "group": "3_open@1"
        },
        {
          "command": "gitComparePlus.fetch",
          "when": "view == gitComparePlus.repositories && viewItem =~ /^comparable\\.repo/",
          "group": "4_git@1"
        },
        {
          "command": "gitComparePlus.createBranch",
          "when": "view == gitComparePlus.repositories && viewItem =~ /^comparable/",
          "group": "4_git@2"
        },
        {
          "command": "gitComparePlus.createWorktree",
          "when": "view == gitComparePlus.repositories && viewItem =~ /^comparable\\.branch\\.(remote|local(?!\\.checkedOut))/",
          "group": "4_git@3"
        },
        {
          "command": "gitComparePlus.switchBranch",
          "when": "view == gitComparePlus.repositories && viewItem =~ /^comparable\\.branch\\.(remote|local(?!\\.checkedOut))/",
          "group": "4_git@4"
        },
        {
          "command": "gitComparePlus.removeWorktree",
          "when": "view == gitComparePlus.repositories && viewItem =~ /^comparable\\.worktree(\\.base)?$/",
          "group": "5_danger@1"
        },
        {
          "command": "gitComparePlus.deleteBranch",
          "when": "view == gitComparePlus.repositories && viewItem =~ /^comparable\\.branch\\.local(?!\\.checkedOut)/",
          "group": "5_danger@2"
        },
        {
          "command": "gitComparePlus.history.compareWithWorkingTree",
          "when": "view == gitComparePlus.history && viewItem =~ /^historyCommit$/",
          "group": "inline@1"
        },
        {
          "command": "gitComparePlus.history.openDiff",
          "when": "view == gitComparePlus.history && viewItem =~ /^historyCommit$/",
          "group": "1_compare@1"
        },
        {
          "command": "gitComparePlus.history.compareWithWorkingTree",
          "when": "view == gitComparePlus.history && viewItem =~ /^historyCommit$/",
          "group": "1_compare@2"
        },
        {
          "command": "gitComparePlus.history.compareWithBranch",
          "when": "view == gitComparePlus.history && viewItem =~ /^historyCommit$/",
          "group": "1_compare@3"
        },
        {
          "command": "gitComparePlus.history.selectForCompare",
          "when": "view == gitComparePlus.history && viewItem =~ /^historyCommit$/",
          "group": "2_select@1"
        },
        {
          "command": "gitComparePlus.history.compareWithSelected",
          "when": "view == gitComparePlus.history && viewItem =~ /^historyCommit$/ && gitComparePlus.historySelected",
          "group": "2_select@2"
        },
        {
          "command": "gitComparePlus.history.compareTwo",
          "when": "view == gitComparePlus.history && viewItem =~ /^historyCommit$/ && listMultiSelection",
          "group": "2_select@3"
        },
        {
          "command": "gitComparePlus.commit.showDetails",
          "when": "viewItem =~ /^(commit|historyCommit)$/",
          "group": "inline@3"
        },
        {
          "command": "gitComparePlus.commit.showDetails",
          "when": "viewItem =~ /^(commit|historyCommit)$/",
          "group": "5_commit@1"
        },
        {
          "command": "gitComparePlus.commit.openAll",
          "when": "viewItem =~ /^(historyCommit|commitsCommit)$/",
          "group": "5_commit@2"
        },
        {
          "command": "gitComparePlus.commit.reviewCommit",
          "when": "viewItem =~ /^(commit|historyCommit|commitsCommit)$/",
          "group": "6_review@1"
        },
        {
          "command": "gitComparePlus.commit.reviewSince",
          "when": "viewItem =~ /^(commit|historyCommit|commitsCommit)$/",
          "group": "6_review@2"
        },
        {
          "command": "gitComparePlus.commit.reviewAgainst",
          "when": "viewItem =~ /^(commit|historyCommit|commitsCommit)$/",
          "group": "6_review@3"
        },
        {
          "command": "gitComparePlus.commit.select",
          "when": "viewItem =~ /^(commit|historyCommit|commitsCommit)$/",
          "group": "7_select@1"
        },
        {
          "command": "gitComparePlus.commit.compareWithSelected",
          "when": "viewItem =~ /^(commit|historyCommit|commitsCommit)$/ && gitComparePlus.commitSelected",
          "group": "7_select@2"
        },
        {
          "command": "gitComparePlus.commit.compareTwo",
          "when": "viewItem =~ /^(commit|historyCommit|commitsCommit)$/ && listMultiSelection",
          "group": "7_select@3"
        },
        {
          "command": "gitComparePlus.commit.copyId",
          "when": "viewItem =~ /^(commit|historyCommit|commitsCommit)$/",
          "group": "9_copy@1"
        },
        {
          "command": "gitComparePlus.stash.openAll",
          "when": "view == gitComparePlus.repositories && viewItem =~ /^stash$/",
          "group": "inline@1"
        },
        {
          "command": "gitComparePlus.stash.apply",
          "when": "view == gitComparePlus.repositories && viewItem =~ /^stash$/",
          "group": "inline@2"
        },
        {
          "command": "gitComparePlus.stash.openAll",
          "when": "view == gitComparePlus.repositories && viewItem =~ /^stash$/",
          "group": "1_open@1"
        },
        {
          "command": "gitComparePlus.stash.apply",
          "when": "view == gitComparePlus.repositories && viewItem =~ /^stash$/",
          "group": "2_apply@1"
        },
        {
          "command": "gitComparePlus.stash.pop",
          "when": "view == gitComparePlus.repositories && viewItem =~ /^stash$/",
          "group": "2_apply@2"
        },
        {
          "command": "gitComparePlus.stash.drop",
          "when": "view == gitComparePlus.repositories && viewItem =~ /^stash$/",
          "group": "5_danger@1"
        },
        {
          "command": "gitComparePlus.history.showFile",
          "when": "viewItem =~ /^(changedFile\\.|commitsFile$|stashFile$|uncommittedFile$)/",
          "group": "8_history@1"
        },
        {
          "command": "gitComparePlus.commits.reviewUncommitted",
          "when": "view == gitComparePlus.commits && viewItem =~ /^uncommittedGroup$/",
          "group": "inline@1"
        },
        {
          "command": "gitComparePlus.commits.reviewUncommitted",
          "when": "view == gitComparePlus.commits && viewItem =~ /^uncommittedGroup$/",
          "group": "1_review@1"
        }
      ],
