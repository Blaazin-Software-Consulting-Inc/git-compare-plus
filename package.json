    "menus": {
      "view/title": [
        {
          "command": "gitComparePlus.compareTwo",
          "when": "view == gitComparePlus.repositories",
          "group": "navigation@0"
        },
        {
          "command": "gitComparePlus.compareAll",
          "when": "view == gitComparePlus.repositories",
          "group": "navigation@1"
        },
        {
          "command": "gitComparePlus.fetchAll",
          "when": "view == gitComparePlus.repositories",
          "group": "navigation@1"
        },
        {
          "command": "gitComparePlus.refresh",
          "when": "view == gitComparePlus.repositories",
          "group": "navigation@2"
        },
        {
          "command": "gitComparePlus.openAllChanges",
          "when": "view == gitComparePlus.changes && gitComparePlus.hasComparison",
          "group": "navigation@1"
        },
        {
          "command": "gitComparePlus.rerun",
          "when": "view == gitComparePlus.changes && gitComparePlus.hasComparison",
          "group": "navigation@2"
        },
        {
          "command": "gitComparePlus.clear",
          "when": "view == gitComparePlus.changes && gitComparePlus.hasComparison",
          "group": "navigation@3"
        },
        {
          "command": "gitComparePlus.viewAsTree",
          "when": "view == gitComparePlus.changes && gitComparePlus.hasComparison && gitComparePlus.changesLayout != tree",
          "group": "navigation@4"
        },
        {
          "command": "gitComparePlus.viewAsList",
          "when": "view == gitComparePlus.changes && gitComparePlus.hasComparison && gitComparePlus.changesLayout == tree",
          "group": "navigation@4"
        },
        {
          "command": "gitComparePlus.changeBase",
          "when": "view == gitComparePlus.changes && gitComparePlus.hasComparison",
          "group": "1_setup@1"
        },
        {
          "command": "gitComparePlus.swapSides",
          "when": "view == gitComparePlus.changes && gitComparePlus.hasComparison",
          "group": "1_setup@4"
        },
        {
          "command": "gitComparePlus.changeSubject",
          "when": "view == gitComparePlus.changes && gitComparePlus.hasComparison",
          "group": "1_setup@0"
        },
        {
          "command": "gitComparePlus.toggleUncommitted",
          "when": "view == gitComparePlus.changes && gitComparePlus.hasComparison",
          "group": "1_setup@2"
        },
        {
          "command": "gitComparePlus.toggleMode",
          "when": "view == gitComparePlus.changes && gitComparePlus.hasComparison",
          "group": "1_setup@3"
        },
        {
          "command": "gitComparePlus.fetchAndRerun",
          "when": "view == gitComparePlus.changes && gitComparePlus.hasComparison",
          "group": "navigation@2"
        },
        {
          "command": "gitComparePlus.history.showFile",
          "when": "view == gitComparePlus.history",
          "group": "navigation@1"
        },
        {
          "command": "gitComparePlus.commits.search",
          "when": "view == gitComparePlus.commits",
          "group": "navigation@1"
        },
        {
          "command": "gitComparePlus.commits.clear",
          "when": "view == gitComparePlus.commits",
          "group": "navigation@2"
        },
        {
          "command": "gitComparePlus.commits.showFullHistory",
          "when": "view == gitComparePlus.commits && gitComparePlus.commitsBranchMode == auto",
          "group": "navigation@0"
        },
        {
          "command": "gitComparePlus.commits.showAheadOnly",
          "when": "view == gitComparePlus.commits && gitComparePlus.commitsBranchMode == history",
          "group": "navigation@0"
        },
        {
          "command": "gitComparePlus.history.close",
          "when": "view == gitComparePlus.history",
          "group": "navigation@9"
        }
      ],
      "view/item/context": [
        {
          "command": "gitComparePlus.changeSubject",
          "when": "view == gitComparePlus.changes && viewItem =~ /^header\\.subject$/",
          "group": "inline@1"
        },
        {
          "command": "gitComparePlus.swapSides",
          "when": "view == gitComparePlus.changes && viewItem =~ /^header\\.(subject|base)$/",
          "group": "inline@2"
        },
        {
          "command": "gitComparePlus.changeDefaultBase",
          "when": "view == gitComparePlus.repositories && viewItem =~ /^comparable\\.repo/",
          "group": "2_base@0"
        },
        {
          "command": "gitComparePlus.openBranch",
          "when": "view == gitComparePlus.repositories && viewItem =~ /^comparable\\.branch/",
          "group": "inline@2"
        },
        {
          "command": "gitComparePlus.openBranch",
          "when": "view == gitComparePlus.repositories && viewItem =~ /^comparable\\.branch/",
          "group": "0_open@1"
        },
        {
          "command": "gitComparePlus.openFile",
          "when": "view == gitComparePlus.changes && viewItem =~ /^changedFile\\.(?!deleted$)/",
          "group": "inline@1"
        },
        {
          "command": "gitComparePlus.openFile",
          "when": "view == gitComparePlus.changes && viewItem =~ /^changedFile\\.(?!deleted$)/",
          "group": "1_open@1"
        },
        {
          "command": "gitComparePlus.openFileAtBase",
          "when": "view == gitComparePlus.changes && viewItem =~ /^changedFile\\.(?!(added|untracked)$)/",
