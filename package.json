{
  "name": "branch-compare",
  "displayName": "Git Branch & Worktree Compare",
  "description": "Compare git worktrees and branches with main (or any branch) and review the changed files side by side. Works with a single repository or many repositories in one window.",
  "version": "0.9.0",
  "publisher": "local",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "SCM Providers"
  ],
  "keywords": [
    "git",
    "worktree",
    "branch",
    "diff",
    "compare",
    "multi-root"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionDependencies": [
    "vscode.git"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "branchCompare",
          "title": "Git Branch & Worktree Compare",
          "icon": "media/activity-icon.svg"
        }
      ]
    },
    "views": {
      "branchCompare": [
        {
          "id": "branchCompare.repositories",
          "name": "Repositories"
        },
        {
          "id": "branchCompare.changes",
          "name": "Changes"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "branchCompare.changes",
        "contents": "Nothing compared yet.\n\n[Compare…](command:branchCompare.compareTwo)\n\nPicks what to review, then what to compare it against. Or, in Repositories, click $(git-compare) next to a worktree or branch to review it against its repo's default branch.\n\n[Compare All Repos With Default Branch](command:branchCompare.compareAll)"
      }
    ],
    "commands": [
      {
        "command": "branchCompare.refresh",
        "title": "Refresh",
        "category": "Branch & Worktree Compare",
        "icon": "$(refresh)"
      },
      {
        "command": "branchCompare.compareAll",
        "title": "Compare All Repos With Default Branch",
        "category": "Branch & Worktree Compare",
        "icon": "$(diff-multiple)"
      },
      {
        "command": "branchCompare.compare",
        "title": "Review Against Default",
        "category": "Branch & Worktree Compare",
        "icon": "$(git-compare)"
      },
      {
        "command": "branchCompare.compareWith",
        "title": "Review Against…",
        "category": "Branch & Worktree Compare"
      },
      {
        "command": "branchCompare.setBase",
        "title": "Use as Default Against",
        "category": "Branch & Worktree Compare",
        "icon": "$(target)"
      },
      {
        "command": "branchCompare.clearBase",
        "title": "Reset Default Against (use the default branch)",
        "category": "Branch & Worktree Compare",
        "icon": "$(close)"
      },
      {
        "command": "branchCompare.openWorktree",
        "title": "Open Worktree in New Window",
        "category": "Branch & Worktree Compare",
        "icon": "$(empty-window)"
      },
      {
        "command": "branchCompare.openChange",
        "title": "Open Change",
        "category": "Branch & Worktree Compare"
      },
      {
        "command": "branchCompare.openAllChanges",
        "title": "Open All Changes",
        "category": "Branch & Worktree Compare",
        "icon": "$(diff-multiple)"
      },
      {
        "command": "branchCompare.openBranch",
        "title": "Open…",
        "category": "Branch & Worktree Compare",
        "icon": "$(window)"
      },
      {
        "command": "branchCompare.goTo",
        "title": "Go to Worktree or Branch…",
        "category": "Branch & Worktree Compare",
        "icon": "$(list-tree)"
      },
      {
        "command": "branchCompare.compareTwo",
        "title": "Compare…",
        "category": "Branch & Worktree Compare",
        "icon": "$(git-compare)"
      },
      {
        "command": "branchCompare.changeSubject",
        "title": "Change What Is Reviewed…",
        "category": "Branch & Worktree Compare",
        "icon": "$(list-selection)"
      },
      {
        "command": "branchCompare.changeDefaultBase",
        "title": "Change Default Against…",
        "category": "Branch & Worktree Compare"
      },
      {
        "command": "branchCompare.viewAsTree",
        "title": "View as Tree",
        "category": "Branch & Worktree Compare",
        "icon": "$(list-tree)"
      },
      {
        "command": "branchCompare.viewAsList",
        "title": "View as List",
        "category": "Branch & Worktree Compare",
        "icon": "$(list-flat)"
      },
      {
        "command": "branchCompare.swapSides",
        "title": "Swap Sides",
        "category": "Branch & Worktree Compare",
