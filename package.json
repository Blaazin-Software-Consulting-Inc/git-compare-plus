        "category": "Git Compare+",
        "icon": "$(search)"
      },
      {
        "command": "gitComparePlus.commits.openFile",
        "title": "Open Change",
        "category": "Git Compare+"
      },
      {
        "command": "gitComparePlus.commits.clear",
        "title": "Clear",
        "category": "Git Compare+",
        "icon": "$(clear-all)"
      },
      {
        "command": "gitComparePlus.commit.showDetails",
        "title": "Show Commit Details",
        "category": "Git Compare+",
